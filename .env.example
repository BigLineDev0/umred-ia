# URL de l'API Django (sans slash final)
DJANGO_API_URL=http://localhost:8000/api

# DOIT être identique à la SECRET_KEY de Django : c'est elle qui signe les
# JWT (SIMPLE_JWT n'a pas de SIGNING_KEY dédiée).
JWT_SECRET_KEY=change-moi-en-production
JWT_ALGORITHM=HS256

# Identique au TACHES_TOKEN de Django : autorise n8n à faire rédiger la
# synthèse hebdomadaire (POST /api/pilotage/synthese/rediger). Vide : route désactivée.
TACHES_TOKEN=

# Facultatif : uniquement pour télécharger un modèle privé depuis Hugging Face
HUGGINGFACE_API_KEY=

# Facultatif (valeurs par défaut indiquées)
# MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
# CORS_ORIGINS=["http://localhost:4200"]
# TIME_ZONE=Africa/Dakar   (identique au TIME_ZONE de Django)
# RATE_LIMIT_PAR_MINUTE=20
# SESSION_TTL_MINUTES=30
# CONVERSATION_LIBRE=false   (true : réponses libres du modèle hors commande, ~10 s chacune)
